DATABASE_URL=sqlite:///./fret_coach.db
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000

# Optional Google Identity Services sign-in
GOOGLE_CLIENT_ID=

# Optional private score storage. Keep the secret key in this API only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SCORE_BUCKET=fret-coach-scores
